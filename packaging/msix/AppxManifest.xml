<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for Stratum.

  Requirements before packaging:
    - The Publisher below MUST exactly match the subject of the signing
      certificate (for example "CN=Arkynox" for an OV/EV cert, or the local
      test subject for a self-signed certificate).
    - Provide the referenced Assets\*.png images (44x44, 150x150, 310x150,
      StoreLogo) next to this manifest.
    - Package with the MSIX Packaging Tool or MakeAppx:
        MakeAppx.exe pack /d <layout-dir> /p Stratum.msix
        signtool.exe sign /fd SHA256 /a /f cert.pfx Stratum.msix

  The identifier matches tauri.conf.json (com.arkynox.stratum); the package
  Name uses dots, which is valid for MSIX.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity
    Name="Arkynox.Stratum"
    Publisher="CN=Arkynox"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Stratum</DisplayName>
    <PublisherDisplayName>Arkynox</PublisherDisplayName>
    <Description>Local-first, versioned, searchable asset vault for game studios</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="Stratum" Executable="stratum.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Stratum"
        Description="Local-first, versioned, searchable asset vault for game studios"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
