{
  "productName": "Stratum",
  "version": "0.1.0",
  "identifier": "com.arkynox.stratum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run licenses && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Stratum",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#0b1018",
        "devtools": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AkkilMG/Stratum/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMkU1NDFBRkVCNDMwREQKUldUZE1MVCtHbFF1OHFBSnFidU5jdnl2NkR0NnBPRU9FTnZnZ1BRQWhmUTdGcGpMY1BrNDE2ZlMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first game asset vault",
    "longDescription": "Versioned, searchable, offline-first management for game art, maps and 3D models.",
    "publisher": "Arkynox",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "signCommand": {
        "cmd": "powershell",
        "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "../scripts/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    },
    "copyright": "© 2026 Arkynox. Stratum is free and open source, dual-licensed under the Stratum Community License or Apache-2.0 (SPDX: Apache-2.0 OR LicenseRef-Stratum-Community-1.0). Developed by Akkil M G.",
    "resources": [
      "../THIRD_PARTY_NOTICES.txt",
      "../LICENSE.txt",
      "../LICENSE-APACHE.txt",
      "../LICENSING.md",
      "../NOTICE",
      "../TRADEMARK.md",
      "../legal/EULA.md",
      "../legal/PRIVACY.md",
      "../legal/EXTERNAL.md",
      "../legal/OPEN_SOURCE.md"
    ]
  }
}