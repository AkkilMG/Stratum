{
  "productName": "Stratum",
  "version": "0.1.0",
  "identifier": "dev.stratum.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run licenses && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stratum",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Local-first game asset vault",
    "longDescription": "Versioned, searchable, offline-first management for game art, maps and 3D models.",
    "publisher": "Arkynox",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "licenseFile": "../LICENSE.txt"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    },
    "copyright": "\u00a9 2026 Arkynox. All rights reserved. Developed by Akkil M G.",
    "resources": [
      "../THIRD_PARTY_NOTICES.txt",
      "../LICENSE.txt"
    ]
  }
}