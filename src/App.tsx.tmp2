import { useCallback, useEffect, useMemo, useRef, useState, type ReactNode } from "react";
import { listen } from "@tauri-apps/api/event";
import { getCurrentWebview } from "@tauri-apps/api/webview";
import { open } from "@tauri-apps/plugin-dialog";
import { call, setDemo } from "./services/api";
import { Tour, Step } from "./components/onboarding/Tour";
import Wizard from "./components/onboarding/Wizard";
import { Gate, LegalView } from "./components/legal"; import { POLICY_VERSION, getAcceptance } from "./config/legal"; // fix;
import { About, Settings, copy } from "./components/settings/Settings";
import { Modal, Credits } from "./components/common";
import { Splash } from "./components/onboarding/Splash";
import { LanguageScreen } from "./components/onboarding/LanguageScreen";
import { POLICY_VERSION, getAcceptance } from "./components/legal"; import { POLICY_VERSION, getAcceptance } from "./config/legal"; // fix;
import { ago, errText, fmtBytes, msgText, tr, useI18n, type Key } from "./i18n";
import mark from "./assets/stratum-mark.png";
import type { Asset, Ask, Cfg, Check, Commit, Stats } from "./types";
import "./styles/styles.css";

type View = "overview" | "library" | "activity" | "settings" | "legal";
type Sync = { ok: boolean; msg: string; at: number };
const KC: Record<string, string> = { Image: "#2b50ff", Vector: "#00a389", Source: "#e69a1a", Model: "#b4439a", Audio: "#6b7a90", Other: "#98a3b3" };
const tagList = (t: string) => t.split(",").map((x) => x.trim()).filter(Boolean);
const cache = new Map<string, string | null>();
const getSpaces = (): Cfg[] => { try { return JSON.parse(localStorage.getItem("spaces") || "[]"); } catch { return []; } };
const saveSpace = (c: Cfg) => localStorage.setItem("spaces", JSON.stringify([c, ...getSpaces().filter((x) => x.local !== c.local)].slice(0, 6)));
const base = (p: string) => p.split(/[\\/]/).filter(Boolean).pop() || p;
const Ic = {
  overview: <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>,
  library: <svg viewBox="0 0 24 24"><rect x="3" y="3" width="8" height="8" rx="1.5" /><rect x="13" y="3" width="8" height="8" rx="1.5" /><rect x="3" y="13" width="8" height="8" rx="1.5" /><rect x="13" y="13" width="8" height="8" rx="1.5" /></svg>,
  activity: <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>,
  settings: <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9L7 7M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1" /></svg>,
  add: <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>,
};
const HI = {
  plus: <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="16" /><path d="M24 16v16M16 24h16" /></svg>,
  folder: <svg viewBox="0 0 48 48"><path d="M6 14a3 3 0 0 1 3-3h10l4 5h16a3 3 0 0 1 3 3v17a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3z" /></svg>,
  team: <svg viewBox="0 0 48 48"><circle cx="18" cy="17" r="6" /><circle cx="33" cy="19" r="5" /><path d="M6 40c0-8 6-12 12-12s12 4 12 12M31 29c6 0 11 4 11 11" /></svg>,
  tour: <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17" /><path d="M20 16l13 8-13 8z" /></svg>,
};

function Page({ children }: { children: ReactNode }) {
  return (
    <div className="wiz"><div className="contours" aria-hidden />
      <header className="wtop"><div className="brand"><img className="mark" src={mark} alt="" /><span>Stratum</span></div></header>
      <div className="wscroll"><section className="wmain wide">{children}<Credits logo /></section></div></div>
  );
}

function Home({ spaces, busy, err, onOpen, onForget, onNew, onFolder, onJoin, onTour }: {
  spaces: Cfg[]; busy: boolean; err: string; onOpen: (c: Cfg) => void; onForget: (c: Cfg) => void; onNew: () => void; onFolder: () => void; onJoin: () => void; onTour: () => void;
}) {
  const { t } = useI18n();
  return (
    <Page>
      <h1>{t("h.title")}</h1>
      <p className="lead sm">{t("h.lead")}</p>
      <div className="modes">
        <button className="mode" onClick={onNew}>{HI.plus}<b>{t("h.new")}</b><span>{t("h.new_d")}</span></button>
        <button className="mode" onClick={onFolder}>{HI.folder}<b>{t("h.open")}</b><span>{t("h.open_d")}</span></button>
        <button className="mode" onClick={onJoin}>{HI.team}<b>{t("h.join")}</b><span>{t("h.join_d")}</span></button>
        <button className="mode" onClick={onTour}>{HI.tour}<b>{t("h.tour")}</b><span>{t("h.tour_d")}</span></button>
      </div>
      {spaces.length > 0 && <><h3 className="sub">{t("h.spaces")}</h3>
        <ul className="spaces">{spaces.map((s) => (
          <li key={s.local}><button onClick={() => onOpen(s)}><b>{base(s.local)}</b><span>{s.local}</span></button><button className="icon" aria-label={t("h.forget_n", { n: base(s.local) })} title={t("h.forget")} onClick={() => onForget(s)}>✕</button></li>))}</ul></>}
      {busy && <p className="hint">{t("c.opening")}</p>}
      {err && <p className="err">{errText(err)}</p>}
    </Page>
  );
}

function Thumb({ a }: { a: Asset }) {
  const key = a.path + a.mtime;
  const [src, setSrc] = useState<string | null | undefined>(cache.get(key));
  useEffect(() => {
    if (cache.has(key)) return setSrc(cache.get(key));
    call<string | null>("thumb", { path: a.path }).then((s) => { cache.set(key, s); setSrc(s); });
  }, [key]);
  return src ? <img src={src} alt={a.name} loading="lazy" /> : <span className="glyph" style={{ color: KC[a.kind] }}>{a.kind}</span>;
}

function Detail({ a, onClose, onChanged, note, onPick, ask }: { a: Asset; onClose: () => void; onChanged: () => void; note: (m: string) => void; onPick: () => void; ask: (o: Ask) => void }) {
  const { t } = useI18n();
  const [log, setLog] = useState<Commit[]>([]);
  const [pick, setPick] = useState<Commit | null>(null);
  const [old, setOld] = useState<string | null>(null);
  const [draft, setDraft] = useState("");
  useEffect(() => { setPick(null); setOld(null); call<Commit[]>("history", { path: a.path }).then(setLog); }, [a.path, a.mtime]);
  useEffect(() => { setOld(null); if (pick) { onPick(); call<string | null>("version_preview", { path: a.path, hash: pick.hash }).then(setOld); } }, [pick]);
  const tags = tagList(a.tags);
  const save = async (x: string[]) => { await call("set_tags", { path: a.path, tags: x.join(", ") }); onChanged(); };
  const restore = () => {
    if (!pick) return;
    ask({ title: t("d.confirm_t", { name: a.name }), body: t("d.confirm_b", { h: pick.hash, when: pick.when }), label: t("d.confirm_ok"),
      run: async () => { await call("restore", { path: a.path, hash: pick.hash }); note(t("t.restored", { name: a.name, h: pick.hash })); onChanged(); } });
  };
  return (
    <aside className="drawer">
      <header><div><h3>{a.name}</h3><p>{a.path}</p></div><button className="icon" onClick={onClose} aria-label={t("c.close")}>✕</button></header>
      <div className="compare">
        <figure><div className="frame"><Thumb a={a} /></div><figcaption>{t("d.current")}</figcaption></figure>
        {pick && <figure><div className="frame">{old ? <img src={old} /> : <span className="glyph">{t("d.no_preview")}</span>}</div><figcaption>{pick.hash} · {pick.when}</figcaption></figure>}
      </div>
      <dl><dt>{t("d.type")}</dt><dd>{t(`k.${a.kind}` as Key)}</dd><dt>{t("d.size")}</dt><dd>{fmtBytes(a.size)}</dd><dt>{t("d.modified")}</dt><dd>{ago(a.mtime)}</dd></dl>
      <h4>{t("d.tags")}</h4>
      <div className="tags" data-t="tags">
        {tags.map((x) => <span key={x}>{x}<button aria-label={t("d.remove_tag", { t: x })} onClick={() => save(tags.filter((y) => y !== x))}>×</button></span>)}
        <input value={draft} placeholder={a.tagged ? t("d.add_tag") : t("d.pending_tag")} onChange={(e) => setDraft(e.target.value)}
          onKeyDown={(e) => { if (e.key === "Enter" && draft.trim()) { save([...tags, draft.trim().toLowerCase()]); setDraft(""); } }} />
      </div>
      <h4>{t("d.versions")} <small>{log.length}</small></h4>
      <ul className="log" data-t="versions">
        {log.map((c) => (<li key={c.hash} className={pick?.hash === c.hash ? "on" : ""} onClick={() => setPick(c)}><b>{c.msg}</b><span>{c.hash} · {c.when} · {c.author}</span></li>))}
      </ul>
      <button className="primary" data-t="restore" disabled={!pick} onClick={restore}>{pick ? t("d.restore", { h: pick.hash }) : t("d.pick")}</button>
    </aside>
  );
}

export default function App() {
  const { t, lang } = useI18n();
  const [splash, setSplash] = useState(true);
  const [langOk, setLangOk] = useState(localStorage.getItem("langOk") === "1");
  const [vault, setVault] = useState<string | null>(null);
  const [wizard, setWizard] = useState<{ start: number; mode?: Cfg["mode"] } | null>(null);
  const [booting, setBooting] = useState(!!localStorage.getItem("cfg"));
  const [spaces, setSpaces] = useState<Cfg[]>(getSpaces);
  const [recover, setRecover] = useState(false);
  const [demo, setDemoState] = useState(false);
  const [tour, setTour] = useState<number | null>(null);
  const [picked, setPicked] = useState(false);
  const [view, setView] = useState<View>("overview");
  const [stats, setStats] = useState<Stats | null>(null);
  const [assets, setAssets] = useState<Asset[]>([]);
  const [q, setQ] = useState("");
  const [results, setResults] = useState<Asset[] | null>(null);
  const [kind, setKind] = useState("All");
  const [tag, setTag] = useState("");
  const [sort, setSort] = useState(localStorage.getItem("sort") || "recent");
  const [dense, setDense] = useState(localStorage.getItem("dense") === "1");
  const [legalOk, setLegalOk] = useState(() => getAcceptance()?.v === POLICY_VERSION);
  const [theme, setTheme] = useState(localStorage.getItem("theme") || "system");
  const [author, setAuthor] = useState(localStorage.getItem("author") || "");
  const [loading, setLoading] = useState(true);
  const [about, setAbout] = useState(false);
  const [help, setHelp] = useState(false);
  const [ask, setAsk] = useState<Ask | null>(null);
  const [sel, setSel] = useState<Asset | null>(null);
  const [busy, setBusy] = useState(false);
  const [drag, setDrag] = useState(false);
  const [err, setErr] = useState("");
  const [toast, setToast] = useState("");
  const [log, setLog] = useState<Commit[]>([]);
  const [remote, setRemote] = useState("");
  const [syncing, setSyncing] = useState(false);
  const [syncSt, setSyncSt] = useState<Sync | null>(null);
  const [pal, setPal] = useState<string | null>(null);
  const vaultRef = useRef<string | null>(null);
  const searchRef = useRef<HTMLInputElement>(null);
  const note = (m: string) => { setToast(m); setTimeout(() => setToast(""), 4500); };

  const load = useCallback(async () => {
    try {
      const [s, a] = await Promise.all([call<Stats>("stats"), call<Asset[]>("list_assets")]);
      setStats(s); setAssets(a); setSel((c) => (c ? a.find((x) => x.path === c.path) ?? null : null));
    } catch (e) { setErr(String(e)); } finally { setLoading(false); }
  }, []);

  const openVault = useCallback(async (cfg: Cfg, remote: string | null) => {
    setBusy(true); setErr("");
    try {
      await call("set_author", { name: cfg.name || "Me" });
      await call("open_vault", { path: cfg.local, lfs: cfg.lfs, remote });
      localStorage.setItem("cfg", JSON.stringify(cfg)); localStorage.setItem("author", cfg.name);
      setVault(cfg.local); vaultRef.current = cfg.local; saveSpace(cfg); setSpaces(getSpaces()); localStorage.setItem("seen", "1"); setWizard(null); setRecover(false); await load();
    } catch (e) { setBusy(false); throw e; }
  }, [load]);

  const startDemo = () => {
    setDemo(true); setDemoState(true); setWizard(null); setVault("Demo"); setView("overview"); setSel(null); setQ(""); setPicked(false); load(); setTour(0);
  };
  // After the tour (finished or skipped) the user is never forced anywhere: back to their space if they have one, otherwise the home screen.
  const exitDemo = (to: "setup" | "home") => {
    setDemo(false); setDemoState(false); setTour(null); setSel(null); setQ(""); setView("overview");
    const rv = vaultRef.current;
    if (rv) { setVault(rv); load(); }
    else { setVault(null); setAssets([]); setStats(null); localStorage.setItem("seen", "1"); if (to === "setup") setWizard({ start: 1, mode: "hub" }); }
  };
  const boot = useCallback(() => {
    const raw = localStorage.getItem("cfg");
    if (!raw) { setBooting(false); if (!localStorage.getItem("seen")) setWizard({ start: 0 }); return; }
    setBooting(true); setErr("");
    openVault(JSON.parse(raw) as Cfg, null).catch((e) => { setErr(String(e)); setRecover(true); }).finally(() => setBooting(false));
  }, [openVault]);
  const quickOpen = async () => {
    const p = await open({ directory: true });
    if (typeof p !== "string") return;
    try { await openVault({ name: localStorage.getItem("author") || "Me", mode: "local", local: p, nas: "", lfs: false }, null); } catch (e) { setErr(String(e)); }
  };

  useEffect(() => { if (legalOk && langOk) boot(); }, [boot, legalOk, langOk]);
  useEffect(() => { localStorage.setItem("sort", sort); localStorage.setItem("dense", dense ? "1" : "0"); }, [sort, dense]);
  useEffect(() => {
    if (theme === "system") delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = theme;
    localStorage.setItem("theme", theme);
  }, [theme]);
  useEffect(() => {
    const subs = [listen("vault-changed", load), listen<boolean>("busy", (e) => setBusy(e.payload)), listen<Sync>("sync-state", (e) => { setSyncSt(e.payload); load(); }),
      getCurrentWebview().onDragDropEvent((ev) => {
        const p = ev.payload;
        if (p.type === "enter" || p.type === "over") setDrag(true);
        else if (p.type === "drop") { setDrag(false); call<number>("import_files", { paths: p.paths }).then((n) => note(tr("t.added", { n }))).catch((e) => setErr(String(e))); }
        else setDrag(false);
      })];
    return () => { subs.forEach((s) => s.then((f) => f()).catch(() => {})); };
  }, [load]);
  useEffect(() => {
    if (!q.trim()) return setResults(null);
    const x = setTimeout(() => call<Asset[]>("search", { query: q }).then(setResults).catch((e) => setErr(String(e))), 300);
    return () => clearTimeout(x);
  }, [q]);
  useEffect(() => {
    if (view !== "activity" || !vault) return;
    call<Commit[]>("activity").then(setLog); call<string>("get_remote").then(setRemote);
  }, [view, vault, stats?.commits]);
  useEffect(() => {
    const k = (e: KeyboardEvent) => {
      const typing = ["INPUT", "SELECT", "TEXTAREA"].includes(document.activeElement?.tagName ?? "");
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") { e.preventDefault(); setPal(""); }
      else if (e.key === "/" && !typing) { e.preventDefault(); searchRef.current?.focus(); }
      else if (e.key === "?" && !typing) setHelp(true);
      else if (e.key === "Escape") { setSel(null); setPal(null); }
    };
    window.addEventListener("keydown", k); return () => window.removeEventListener("keydown", k);
  }, []);

  const sync = async () => {
    setSyncing(true);
    try { if (remote) await call("set_remote", { url: remote }); note(msgText(await call<string>("sync"))); await load(); } catch (e) { setErr(String(e)); } finally { setSyncing(false); }
  };
  const addFiles = async () => { const p = await open({ multiple: true }); if (p) { const n = await call<number>("import_files", { paths: Array.isArray(p) ? p : [p] }); note(t("t.added_short", { n })); } };
  const switchVault = () => { vaultRef.current = null; setVault(null); setStats(null); setAssets([]); setSel(null); setErr(""); };
  const saveName = async (n: string) => {
    setAuthor(n); localStorage.setItem("author", n); await call("set_author", { name: n });
    try { const c = JSON.parse(localStorage.getItem("cfg") || "null"); if (c) localStorage.setItem("cfg", JSON.stringify({ ...c, name: n })); } catch {}
    note(t("t.name_saved"));
  };
  const diag = async () => {
    const c = await call<Check>("system_check").catch(() => null);
    return ["Stratum diagnostics", `Policy version: ${getAcceptance()?.v ?? "not accepted"}`, `Language: ${lang}`, `Platform: ${navigator.userAgent}`,
      `Assets: ${stats?.assets ?? "?"}, versions: ${stats?.commits ?? "?"}, tagged: ${stats?.tagged ?? "?"}`, `Network drive: ${stats?.network ?? "?"}, NAS connected: ${stats ? !!stats.remote : "?"}, waiting to sync: ${stats?.ahead ?? "?"}`,
      `Git: ${c?.git}, Git LFS: ${c?.lfs}, Ollama: ${c?.ollama}, vision model: ${c?.vision}, search model: ${c?.embed}`].join("\n");
  };
  const accept = async () => {
    localStorage.setItem("legal", JSON.stringify({ v: POLICY_VERSION, at: new Date().toISOString() }));
    try { await call("record_acceptance", { version: POLICY_VERSION, user: localStorage.getItem("author") || "" }); } catch {}
    setLegalOk(true);
  };

  const topTags = useMemo(() => {
    const m = new Map<string, number>();
    assets.forEach((a) => tagList(a.tags).forEach((x) => m.set(x, (m.get(x) ?? 0) + 1)));
    return [...m.entries()].sort((a, b) => b[1] - a[1]).slice(0, 14);
  }, [assets]);
  const kinds = ["All", ...Array.from(new Set(assets.map((a) => a.kind)))];
  const shown = useMemo(() => {
    const l = [...(results ?? assets)].filter((a) => (kind === "All" || a.kind === kind) && (!tag || tagList(a.tags).includes(tag)));
    if (!results) l.sort((a, b) => (sort === "name" ? a.name.localeCompare(b.name) : sort === "size" ? b.size - a.size : b.mtime - a.mtime));
    return l;
  }, [results, assets, kind, tag, sort]);
  const maxKind = Math.max(1, ...(stats?.by_kind.map((k) => k[1]) ?? [1]));
  const pending = stats ? stats.assets - stats.tagged : 0;
  const syncText = !stats?.remote ? t("sync.local") : syncSt && !syncSt.ok ? t("sync.offline", { n: stats.ahead }) : stats.ahead > 0 ? t("sync.waiting", { n: stats.ahead }) : syncSt ? t("sync.synced", { when: ago(syncSt.at) }) : t("sync.connected");
  const syncCls = !stats?.remote ? "" : syncSt && !syncSt.ok ? "bad" : stats.ahead > 0 ? "warn" : "ok";
  const kname = (k: string) => (k === "All" ? t("lib.all") : t(`k.${k}` as Key));
  const word = t("tour.q");

  const steps: Step[] = [
    { title: t("tour.0.t"), body: t("tour.0.b") },
    { target: "[data-t=overview]", title: t("tour.1.t"), body: t("tour.1.b") },
    { target: "[data-t=cards]", title: t("tour.2.t"), body: t("tour.2.b") },
    { target: "[data-t=library]", title: t("tour.3.t"), body: t("tour.3.b"), needs: t("tour.3.n"), ok: view === "library" },
    { target: "[data-t=search]", title: t("tour.4.t"), body: t("tour.4.b", { q: word }), needs: t("tour.4.n", { q: word }), ok: q.trim().length > 2 && !!results },
    { target: "[data-t=grid]", title: t("tour.5.t"), body: t("tour.5.b"), needs: t("tour.5.n"), ok: !!sel },
    { target: "[data-t=tags]", title: t("tour.6.t"), body: t("tour.6.b") },
    { target: "[data-t=versions]", title: t("tour.7.t"), body: t("tour.7.b"), needs: t("tour.7.n"), ok: picked },
    { target: "[data-t=restore]", title: t("tour.8.t"), body: t("tour.8.b") },
    { target: "[data-t=activity]", title: t("tour.9.t"), body: t("tour.9.b"), needs: t("tour.9.n"), ok: view === "activity" },
    { target: "[data-t=syncpanel]", title: t("tour.10.t"), body: t("tour.10.b") },
    { title: t("tour.11.t"), body: t("tour.11.b"), art: "drop" },
    { title: t("tour.12.t"), body: t("tour.12.b") },
  ];

  if (splash) return <Splash ready={!(legalOk && langOk && booting)} onDone={() => setSplash(false)} />;
  if (!langOk) return <LanguageScreen onDone={() => { localStorage.setItem("langOk", "1"); setLangOk(true); }} />;
  if (!legalOk) return <Gate onAccept={accept} onDecline={() => { call("quit").catch(() => window.close()); }} />;
  if (wizard) return <Wizard start={wizard.start} mode={wizard.mode} onTour={startDemo} onSkip={() => { localStorage.setItem("seen", "1"); setWizard(null); }} onDone={async (cfg, rem, tr2) => { await openVault(cfg, rem); if (tr2) startDemo(); }} />;
  if (recover) return (
    <Page><h2>{t("r.title")}</h2><p className="lead sm">{errText(err)}</p><p className="hint">{t("r.hint")}</p>
      <div className="row"><button className="primary" onClick={boot}>{t("r.retry")}</button><button className="ghostb" onClick={() => { setRecover(false); setErr(""); }}>{t("r.home")}</button></div></Page>
  );
  if (booting) return <Page><h2>{t("r.opening")}</h2></Page>;
  if (!vault) return (
    <Home spaces={spaces} busy={busy} err={err} onTour={startDemo} onFolder={quickOpen}
      onNew={() => setWizard({ start: 1, mode: "hub" })} onJoin={() => setWizard({ start: 3, mode: "join" })}
      onOpen={(c) => { setErr(""); openVault(c, null).catch((e) => setErr(String(e))); }}
      onForget={(c) => { localStorage.setItem("spaces", JSON.stringify(getSpaces().filter((x) => x.local !== c.local))); setSpaces(getSpaces()); }} />
  );

  const cmds: [string, () => void][] = [[t("pal.settings"), () => setView("settings")], [t("pal.about"), () => setAbout(true)], [t("sc.title"), () => setHelp(true)], [t("pal.legal"), () => setView("legal")],
    [t("pal.overview"), () => setView("overview")], [t("pal.library"), () => setView("library")], [t("pal.activity"), () => setView("activity")], [t("pal.sync"), sync], [t("pal.add"), addFiles],
    [t("pal.tour"), startDemo], [t("pal.new"), () => setWizard({ start: 1, mode: "hub" })], [t("pal.switch"), switchVault], [t("pal.language"), () => setView("settings")]];
  const navLabel: Record<string, string> = { overview: t("nav.overview"), library: t("nav.library"), activity: t("nav.activity") };

  return (
    <div className="app">
      <nav>
        <div className="brand"><img className="mark" src={mark} alt="" /><span className="t">Stratum<small>by Arkynox</small></span></div>
        {(["overview", "library", "activity"] as ("overview" | "library" | "activity")[]).map((v) => (
          <button key={v} data-t={v} title={navLabel[v]} className={view === v ? "on" : ""} onClick={() => setView(v)}>
            {Ic[v]}<span className="t">{navLabel[v]}</span>{v === "library" && stats ? <em>{stats.assets}</em> : null}
          </button>
        ))}
        <button title={t("nav.add")} onClick={addFiles}>{Ic.add}<span className="t">{t("nav.add")}</span></button>
        <div className="spacer" />
        <button data-t="settings" title={t("nav.settings")} className={view === "settings" || view === "legal" ? "on" : ""} onClick={() => setView("settings")}>{Ic.settings}<span className="t">{t("nav.settings")}</span></button>
        <button className={"syncchip " + syncCls} title={syncText} onClick={() => setView("activity")}><i /><span className="t">{syncText}</span></button>
        <div className={"ai " + (stats?.ollama ? "up" : "down")} title={t("s.ai")}><span className="t">{stats?.ollama ? t("ai.on") : t("ai.off")}</span></div>
        <div className="vault" title={vault}><button className="av" onClick={() => setPal("")} aria-label={t("top.actions")}>{(demo ? "D" : base(vault)).slice(0, 1).toUpperCase()}</button><b>{demo ? t("nav.demo") : base(vault)}</b><span>{vault}</span><span><button className="link" onClick={switchVault}>{t("nav.switch")}</button> · <button className="link" onClick={startDemo}>{t("nav.tour")}</button></span></div>
        <button className="aboutlink" onClick={() => setAbout(true)}>{t("nav.about")}</button>
      </nav>
      <main>
        <div className="top">
          <input ref={searchRef} data-t="search" className="search" value={q} onChange={(e) => { setQ(e.target.value); if (!q) setView("library"); }} placeholder={t("top.ph")} aria-label={t("top.ph")} />
          {busy && <span className="pill"><i className="spin" />{t("c.working")}</span>}
          <button className="ghostb" onClick={() => setPal("")} title={t("top.actions_t")}>{t("top.actions")}</button>
        </div>
        {err && <div className="banner" role="alert"><div><b>{t("err.title")}</b><span>{errText(err)}</span></div><button className="link" onClick={async () => note((await copy(err)) ? t("c.copied") : t("c.copy_fail"))}>{t("c.copy_details")}</button><button className="icon" onClick={() => setErr("")} aria-label={t("c.dismiss")}>✕</button></div>}

        {view === "overview" && !stats && <div className="cards" aria-busy="true">{[0, 1, 2, 3].map((k) => <div className="card" key={k}><span className="skel line" /><span className="skel big" /></div>)}</div>}
        {view === "overview" && stats && (
          <>
            <section className="notes">
              {stats.network && <p><b>{t("n.network_b")}</b> {t("n.network")}</p>}
              {!stats.remote && !demo && <p><b>{t("n.nonas_b")}</b> {t("n.nonas")} <button className="link" onClick={() => setView("activity")}>{t("n.connect")}</button></p>}
              {!stats.ollama && <p><b>{t("n.noai_b")}</b> {t("n.noai")}</p>}
              {stats.ollama && pending > 0 && <p><b>{t("n.tagging", { n: pending })}</b><span className="meter"><i style={{ width: `${((stats.assets - pending) / stats.assets) * 100}%` }} /></span></p>}
            </section>
            <section className="cards" data-t="cards">
              {([[t("card.assets"), stats.assets.toLocaleString(lang), t("card.assets_s"), "#2b50ff"], [t("card.storage"), fmtBytes(stats.bytes), t("card.types", { n: stats.by_kind.length }), "#e69a1a"],
                [t("card.tagged"), stats.assets ? Math.round((stats.tagged / stats.assets) * 100) + "%" : "–", t("card.tagged_s", { a: stats.tagged, b: stats.assets }), "#00a389"], [t("card.versions"), stats.commits.toLocaleString(lang), t("card.versions_s"), "#b4439a"]] as string[][]).map(([l, v, s, c]) => (
                <div className="card" key={l}><span className="lbl"><i style={{ background: c }} />{l}</span><strong>{v}</strong><small>{s}</small></div>
              ))}
            </section>
            <div className="two">
              <section className="panel topo"><h2>{t("p.storage")}</h2>
                <div className="bars">{stats.by_kind.map(([k, b]) => (
                  <div className="bar" key={k}><b>{fmtBytes(b)}</b><div className="track"><div className="fill" style={{ height: `${(b / maxKind) * 100}%`, background: KC[k] }} /></div><span>{kname(k)}</span></div>))}</div>
              </section>
              <section className="panel"><h2>{t("p.recent")}</h2>
                {assets.length === 0 ? <p className="empty">{t("p.empty")}</p> :
                  <table><tbody>{assets.slice(0, 7).map((a) => (
                    <tr key={a.path} onClick={() => setSel(a)} tabIndex={0}><td><div className="mini"><Thumb a={a} /></div></td><td><b>{a.name}</b><small>{fmtBytes(a.size)}</small></td>
                      <td><span className={"st " + (a.tagged ? "ok" : "wait")}>{a.tagged ? t("st.tagged") : t("st.pending")}</span></td><td className="r">{ago(a.mtime)}</td></tr>))}</tbody></table>}
              </section>
            </div>
          </>
        )}

        {view === "library" && (
          <>
            <div className="bar2">
              <div className="chips">{kinds.map((k) => <button key={k} className={k === kind ? "on" : ""} onClick={() => setKind(k)}>{kname(k)}</button>)}</div>
              <div className="tools"><select value={sort} onChange={(e) => setSort(e.target.value)} aria-label={t("lib.sort")}><option value="recent">{t("lib.recent")}</option><option value="name">{t("lib.name")}</option><option value="size">{t("lib.largest")}</option></select>
                <button className="icon" onClick={() => setDense(!dense)} aria-label={t("lib.layout")}>{dense ? "▦" : "☰"}</button></div>
            </div>
            {topTags.length > 0 && <div className="chips small">{tag && <button className="on" onClick={() => setTag("")}>{tag} ×</button>}
              {topTags.filter(([x]) => x !== tag).map(([x, n]) => <button key={x} onClick={() => setTag(x)}>{x} <em>{n}</em></button>)}</div>}
            <span className="count">{results ? t("lib.count_matches", { n: shown.length }) : t("lib.count_assets", { n: shown.length })}</span>
            {loading ? <div className="grid">{Array.from({ length: 12 }, (_, k) => <div className="skel tile-skel" key={k} />)}</div> : shown.length === 0 ? (
              <div className="empty big"><div className="dropart"><i /><b /><span>{t("tour.drop")}</span></div><p>{results ? t("lib.empty_search") : t("lib.empty")}</p></div>
            ) : dense ? (
              <table className="list"><tbody>{shown.map((a) => (
                <tr key={a.path} onClick={() => setSel(a)} tabIndex={0} className={sel?.path === a.path ? "on" : ""}><td><div className="mini"><Thumb a={a} /></div></td><td><b>{a.name}</b><small>{a.path}</small></td><td className="hide-sm">{kname(a.kind)}</td><td className="hide-sm">{fmtBytes(a.size)}</td><td className="r">{ago(a.mtime)}</td></tr>))}</tbody></table>
            ) : (
              <div className="grid" data-t="grid">{shown.map((a) => (
                <button key={a.path} className={"tile" + (sel?.path === a.path ? " on" : "")} onClick={() => setSel(a)}>
                  <div className="frame"><Thumb a={a} />{a.tags && <div className="ov">{tagList(a.tags).slice(0, 5).map((x) => <span key={x}>{x}</span>)}</div>}</div><b>{a.name}</b><span>{fmtBytes(a.size)} · {kname(a.kind)}</span>
                </button>))}</div>
            )}
          </>
        )}

        {view === "activity" && (
          <div className="two">
            <section className="panel"><h2>{t("a.history")}</h2>
              <ul className="timeline">{log.map((c) => <li key={c.hash + c.when}><b>{c.msg}</b><span>{c.hash} · {c.when} · {c.author}</span></li>)}</ul></section>
            <section className="panel" data-t="syncpanel"><h2>{t("a.sync")}</h2>
              <p className="lead sm">{t("a.lead")}</p>
              <input className="field" value={remote} onChange={(e) => setRemote(e.target.value)} placeholder="\\nas\studio\stratum-vault.git  /  ssh://git@server/assets.git" aria-label={t("a.sync")} />
              <button className="primary" onClick={sync} disabled={syncing || !remote}>{syncing ? t("a.syncing") : t("a.now")}</button>
              <p className="hint">{t("a.note")}</p>
            </section>
          </div>
        )}
        {view === "settings" && <Settings name={author} onName={saveName} theme={theme} onTheme={setTheme} vault={demo ? t("nav.demo") : vault} stats={stats} demo={demo} onSwitch={switchVault} onTour={startDemo} onHelp={() => setHelp(true)} onAbout={() => setAbout(true)} onLegal={() => setView("legal")} diag={diag} note={note} />}
        {view === "legal" && <LegalView onBack={() => setView("settings")} />}
      </main>
      {sel && <Detail a={sel} onClose={() => setSel(null)} onChanged={load} note={note} onPick={() => setPicked(true)} ask={setAsk} />}
      {drag && <div className="drop"><div>{t("drop.title")}</div></div>}
      {toast && <div className="toast" role="status">{toast}</div>}
      {ask && <Modal title={ask.title} onClose={() => setAsk(null)}><p>{ask.body}</p><div className="row end"><button className="ghostb" onClick={() => setAsk(null)}>{t("c.cancel")}</button><button className="primary" onClick={async () => { const a = ask; setAsk(null); try { await a.run(); } catch (e) { setErr(String(e)); } }}>{ask.label}</button></div></Modal>}
      {about && <About onClose={() => setAbout(false)} onLegal={() => setView("legal")} diag={diag} note={note} />}
      {help && <Modal title={t("sc.title")} onClose={() => setHelp(false)}><dl className="kv keys"><dt><kbd>/</kbd></dt><dd>{t("sc.search")}</dd><dt><kbd>Ctrl</kbd> + <kbd>K</kbd></dt><dd>{t("sc.actions")}</dd><dt><kbd>?</kbd></dt><dd>{t("sc.show")}</dd><dt><kbd>Esc</kbd></dt><dd>{t("sc.close")}</dd><dt>{t("sc.drag")}</dt><dd>{t("sc.drag_d")}</dd></dl></Modal>}
      {pal !== null && (
        <div className="cmdbg" onClick={() => setPal(null)}><div className="cmd" onClick={(e) => e.stopPropagation()}>
          <input autoFocus value={pal} onChange={(e) => setPal(e.target.value)} placeholder={t("pal.ph")} aria-label={t("pal.ph")}
            onKeyDown={(e) => { if (e.key === "Enter") { const m = cmds.find(([n]) => n.toLowerCase().includes(pal.toLowerCase())); if (m) { m[1](); setPal(null); } } }} />
          {cmds.filter(([n]) => n.toLowerCase().includes(pal.toLowerCase())).map(([n, f]) => <button key={n} onClick={() => { f(); setPal(null); }}>{n}</button>)}
        </div></div>
      )}
      {demo && tour !== null && <Tour steps={steps} i={tour} onNext={() => setTour(tour + 1)} onBack={() => setTour(Math.max(0, tour - 1))} onExit={() => exitDemo("home")}
        finish={vaultRef.current ? { label: t("tour.back_space"), onClick: () => exitDemo("home") } : { label: t("tour.setup"), onClick: () => exitDemo("setup") }}
        alt={vaultRef.current ? undefined : { label: t("tour.explore"), onClick: () => exitDemo("home") }} />}
    </div>
  );
}
