# Stratum release/signing environment.
# Copy to .env and fill in real values. Never commit secrets (.env is gitignored;
# this example is the only .env* file that is tracked).
#
# These are build/release-time values, not app runtime config. In CI, the same
# values are configured as repository secrets (or, for WINDOWS_TIMESTAMP_URL, a
# repository variable) under Settings -> Secrets and variables -> Actions.

# GitHub token for publishing releases (gh release upload + tauri-action).
# Fine-grained PAT: Contents = Read and write (+ Actions = Read). Classic: "repo" scope.
TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Authenticode certificate for Windows signing, base64-encoded .pfx (single line).
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("certificate.pfx"))
WINDOWS_CERTIFICATE=<base64 of certificate.pfx>
WINDOWS_CERTIFICATE_PASSWORD=<pfx password>

# RFC 3161 timestamp server (repo variable).
WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com

# Tauri auto-updater signing key (base64 of ~/.tauri/stratum.key) and its password.
# Generate with:  npm run tauri signer generate -- -w ~/.tauri/stratum.key
# Paste the printed PUBLIC key into plugins.updater.pubkey in src-tauri/tauri.conf.json.
TAURI_SIGNING_PRIVATE_KEY=<base64 of ~/.tauri/stratum.key>
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<key password>
