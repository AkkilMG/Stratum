  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkkilMG/Stratum.git"
  },
  "bugs": {
    "url": "https://github.com/AkkilMG/Stratum/issues"
  },
  "keywords": [
    "asset-management",
    "digital-asset-management",
