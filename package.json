    "format:check": "prettier --check .",
    "tauri": "tauri",
    "icons": "tauri icon app-icon.png",
    "licenses": "node scripts/gen-licenses.mjs"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
