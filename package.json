{
  "name": "stratum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stratum: local-first, versioned, searchable asset vault for game studios. A product of Arkynox.",
  "author": {
    "name": "Akkil M G",
    "url": "https://github.com/AkkilMG"
  },
  "license": "Apache-2.0 OR LicenseRef-Stratum-Community-1.0",
  "homepage": "https://github.com/AkkilMG/Stratum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkkilMG/Stratum.git"
  },
  "bugs": {
    "url": "https://github.com/AkkilMG/Stratum/issues"
  },
  "keywords": [
    "asset-management",
    "digital-asset-management",
    "game-development",
    "git",
    "local-first",
    "offline",
    "tauri",
    "version-control"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "icons": "tauri icon app-icon.png",
    "licenses": "node scripts/gen-licenses.mjs",
    "package-manifests": "node scripts/gen-package-manifests.mjs"
  },
  "overrides": {
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
